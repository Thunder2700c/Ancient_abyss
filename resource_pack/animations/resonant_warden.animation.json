{
  "format_version": "1.8.0",
  "animations": {
    "animation.resonant_warden.idle": {
      "loop": true,
      "bones": {
        "body": {
          "position": [0, "math.sin(query.anim_time * 2.0) * 0.35", 0],
          "rotation": [0, 0, "math.sin(query.anim_time * 1.4) * 1.5"]
        },
        "left_tendril": {
          "rotation": [0, 0, "math.sin(query.anim_time * 1.8) * 5.0"]
        },
        "right_tendril": {
          "rotation": [0, 0, "math.sin(query.anim_time * 1.8 + 180) * 5.0"]
        }
      }
    },
    "animation.resonant_warden.walk": {
      "anim_time_update": "query.modified_distance_moved",
      "loop": true,
      "bones": {
        "left_leg": {
          "rotation": ["math.cos(query.anim_time * 38.17) * 32.0", 0, 0]
        },
        "right_leg": {
          "rotation": ["math.cos(query.anim_time * 38.17 + 180) * 32.0", 0, 0]
        },
        "left_arm": {
          "rotation": ["math.cos(query.anim_time * 38.17 + 180) * 12.0", 0, 0]
        },
        "right_arm": {
          "rotation": ["math.cos(query.anim_time * 38.17) * 12.0", 0, 0]
        }
      }
    },
    "animation.resonant_warden.look": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": ["query.target_x_rotation", "query.target_y_rotation", 0]
        }
      }
