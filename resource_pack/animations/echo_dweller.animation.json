{
  "format_version": "1.8.0",
  "animations": {
    "animation.echo_dweller.walk": {
      "loop": true,
      "bones": {
        "leg0": { "rotation": ["math.cos(query.modified_distance_moved * 38.17) * 70", 0, 0] },
