{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "meridian:echo_dweller",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false
		},
		"component_groups": {
			"meridian:init_trust": {
				"minecraft:timer": {
					"looping": false,
					"time": 0.05,
					"time_down_event": { "event": "meridian:trust_initialized" }
				}
			}
		},
		"components": {
			"minecraft:health": { "value": 10, "max": 10 },
			"minecraft:collision_box": { "width": 0.6, "height": 1.9 },
			"minecraft:physics": {},
			"minecraft:movement": { "value": 0.2 },
			"minecraft:navigation.walk": { "can_path_over_water": true, "avoid_water": true },
			"minecraft:movement.basic": {},
			"minecraft:jump.static": {},
			"minecraft:can_climb": false,
			"minecraft:nameable": {},
			"minecraft:type_family": { "family": ["echo_dweller", "meridian_neutral"] },
			"minecraft:behavior.float": { "priority": 0 },
			"minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 8.0 },
			"minecraft:behavior.random_look_around": { "priority": 8 },
			"minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.8 },
			"minecraft:ambient_sound_interval": {
				"value": 12.0,
				"range": 6.0,
				"event_name": "meridian.chime"
			},
			"minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
			"minecraft:persistent": {}
		},
		"events": {
			"minecraft:entity_spawned": { "add": { "component_groups": ["meridian:init_trust"] } },
			"meridian:trust_initialized": {
				"run_command": {
					"command": ["scriptevent meridian:init_trust"]
				}
			}
		}
