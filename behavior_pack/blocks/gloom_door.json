{
  "format_version": "1.21.60",
  "minecraft:block": {
    "description": {
      "identifier": "meridian:gloom_door",
      "states": {
        "meridian:door_half": ["lower", "upper"],
        "meridian:door_open": [false, true]
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"]
        }
      },
      "menu_category": {
        "category": "construction",
        "group": "meridian:itemGroup.name.abyss_blocks"
      }
    },
    "components": {
      "minecraft:destructible_by_mining": {"seconds_to_destroy": 2},
      "minecraft:destructible_by_explosion": {"explosion_resistance": 3},
      "minecraft:geometry": "geometry.gloom_door",
      "minecraft:collision_box": {"origin": [-8, 0, -8], "size": [16, 16, 2]},
      "minecraft:selection_box": {"origin": [-8, 0, -8], "size": [16, 16, 2]},
      "minecraft:material_instances": {
        "*": {"texture": "gloom_door_lower", "render_method": "alpha_test"}
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('meridian:door_half') == 'upper'",
        "components": {
          "minecraft:material_instances": {
            "*": {"texture": "gloom_door_upper", "render_method": "alpha_test"}
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north' && q.block_state('meridian:door_open') == false",
        "components": {"minecraft:transformation": {"rotation": [0, 180, 0]}}
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south' && q.block_state('meridian:door_open') == false",
        "components": {"minecraft:transformation": {"rotation": [0, 0, 0]}}
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west' && q.block_state('meridian:door_open') == false",
        "components": {"minecraft:transformation": {"rotation": [0, 90, 0]}}
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east' && q.block_state('meridian:door_open') == false",
        "components": {"minecraft:transformation": {"rotation": [0, 270, 0]}}
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north' && q.block_state('meridian:door_open') == true",
        "components": {
          "minecraft:transformation": {"rotation": [0, 270, 0]},
          "minecraft:collision_box": {"origin": [-8, 0, -8], "size": [2, 16, 16]},
          "minecraft:selection_box": {"origin": [-8, 0, -8], "size": [2, 16, 16]}
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south' && q.block_state('meridian:door_open') == true",
        "components": {
          "minecraft:transformation": {"rotation": [0, 90, 0]},
          "minecraft:collision_box": {"origin": [-8, 0, -8], "size": [2, 16, 16]},
          "minecraft:selection_box": {"origin": [-8, 0, -8], "size": [2, 16, 16]}
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west' && q.block_state('meridian:door_open') == true",
        "components": {
          "minecraft:transformation": {"rotation": [0, 180, 0]},
          "minecraft:collision_box": {"origin": [-8, 0, -8], "size": [2, 16, 16]},
          "minecraft:selection_box": {"origin": [-8, 0, -8], "size": [2, 16, 16]}
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east' && q.block_state('meridian:door_open') == true",
        "components": {
          "minecraft:transformation": {"rotation": [0, 0, 0]},
          "minecraft:collision_box": {"origin": [-8, 0, -8], "size": [2, 16, 16]},
          "minecraft:selection_box": {"origin": [-8, 0, -8], "size": [2, 16, 16]}
        }
      }
    ]
  }
}