{
  "format_version": "1.21.60",
  "minecraft:block": {
    "description": {
      "identifier": "meridian:obsidian_chain",
      "states": {
        "meridian:axis": ["x", "y", "z"]
      }
    },
    "components": {
      "minecraft:destructible_by_mining": false,
      "minecraft:destructible_by_explosion": false,
      "minecraft:collision_box": false,
      "minecraft:selection_box": false,
      "minecraft:light_dampening": 0,
      "minecraft:geometry": "geometry.obsidian_chain",
      "minecraft:material_instances": {
        "*": {
          "texture": "obsidian_chain",
          "render_method": "opaque",
          "face_dimming": false,
          "ambient_occlusion": 0
        }
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('meridian:axis') == 'x'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 90, 0]
          }
        }
      },
      {
        "condition": "q.block_state('meridian:axis') == 'y'",
        "components": {
          "minecraft:transformation": {
            "rotation": [90, 0, 0]
          }
        }
      }
    ]
  }
}